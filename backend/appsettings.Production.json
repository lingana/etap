{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Jwt": {
    "Key": "your-secret-key-min-32-characters-long-please-change-in-production",
    "Issuer": "ExciseTaxAudit",
    "Audience": "ExciseTaxAuditUsers"
  },
  "AzureOpenAI": {
    "Endpoint": "${AZURE_OPENAI_ENDPOINT}",
    "ApiKey": "${AZURE_OPENAI_APIKEY}",
    "DeploymentId": "${AZURE_OPENAI_DEPLOYMENT}"
  },
  "Fabric": {
    "WorkspaceId": "${FABRIC_WORKSPACE_ID}",
    "EnvironmentId": "${FABRIC_ENVIRONMENT_ID}",
    "LakehouseId": "${FABRIC_LAKEHOUSE_ID}"
  },
  "Database": {
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=ExciseTaxAudit;Trusted_Connection=true;"
  },
  "CacheSettings": {
    "ExplanationCacheDurationDays": 30,
    "AnomalyScoreCacheDurationMinutes": 60
  },
  "RateLimiting": {
    "MaxRequestsPerMinute": 100,
    "MaxBatchSize": 1000
  }
}
